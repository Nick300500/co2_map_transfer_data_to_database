# Copy to .env and fill in. .env is your local file, never commit/share it.

DB_HOST=<server-ip-or-hostname>
DB_PORT=<port>
DB_NAME=opendata
DB_USER=opendata
DB_PASSWORD=

# Postgres schema all transfer_*.py scripts write into.
TARGET_SCHEMA=cosema_inputs

# --- Local source paths -----------------------------------------------
# Fill in the actual paths on this machine for whichever transfer_*.py
# script(s) you're going to run. Leave the others blank.

# open-mastr's local SQLite DB. Default open-mastr location is usually
# ~/.open-MaStR/data/sqlite/open-mastr.db -- verify the real path on this
# machine before running transfer_mastr.py, don't trust this blindly.
MASTR_SQLITE_PATH=

# Folder containing the shapefiles (states.geojson etc., see co2map's
# config.yaml Shapefiles: section for the expected file names).
SHAPEFILES_DIR=

# Folder containing the monthly capacity parquet subfolders
# ({Jahr_Monat}/*.parquet, see co2map's cosema/capacities/mastr.py).
CAPACITIES_DIR=

# Folder containing the yearly demand regionalization factor CSVs
# (see co2map's cosema/input_output/local_files.py).
DEMAND_REG_DATA_DIR=

# Folder containing gen_types_and_emission_factors.csv and MaStr_gen_types.csv.
GENERATION_DATA_DIR=
